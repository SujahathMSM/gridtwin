# Copy this file to .env and fill in your own values. .env is git-ignored: never commit it.

# Meta Model API (https://dev.meta.ai/docs/quickstart)
MODEL_API_KEY=
MODEL_API_BASE=https://api.meta.ai/v1
MUSE_SPARK_MODEL=muse-spark-1.3

# Muse Spark Open on Baseten (optional, open-weights bonus)
BASETEN_API_KEY=
MUSE_SPARK_OPEN_MODEL=meta-models/muse-spark-open-1026

# Hardware
NUCLEO_PORT=COM5
# SSH login for the Pi, must work without a password (see docs)
PI_SSH=pi5test@pi5-1.local

# Optional: run the judge on open weights (Muse Spark Open on Baseten)
# JUDGE_PROVIDER=baseten
