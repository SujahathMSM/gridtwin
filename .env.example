# Copy this file to .env and fill in your own values. .env is git-ignored: never commit it.

# Meta Model API (https://dev.meta.ai/docs/quickstart)
MODEL_API_KEY=
MODEL_API_BASE=https://api.meta.ai/v1
MUSE_SPARK_MODEL=muse-spark-1.3

# Muse Spark Open on Baseten (open weights). Find the exact id with: python agents/check_models.py
BASETEN_API_KEY=
MUSE_SPARK_OPEN_MODEL=

# Which model each agent uses: meta (Muse Spark, default) or baseten (Muse Spark Open).
# Optional <ROLE>_MODEL overrides the model id for one agent.
ATTACKER_PROVIDER=meta
JUDGE_PROVIDER=meta
FIXER_PROVIDER=meta

# Hardware
NUCLEO_PORT=COM5
# SSH login for the Pi, must work without a password (see docs)
PI_SSH=pi5test@pi5-1.local
