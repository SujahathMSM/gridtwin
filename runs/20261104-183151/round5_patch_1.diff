 class TripLine:
-    """GPIO23 safety-trip output. Falls back to a dummy when --no-gpio is set."""
+    """Failsafe trip output on GPIO23: HIGH=permissive (battery allowed),
+    LOW=trip. Falls back to a dummy when --no-gpio is set.
+
+    API preserved: set(True) = TRIP (drive LOW, latched), set(False) =
+    release/permissive (drive HIGH). Starts HIGH so idle healthy link is
+    permissive.
+    """
 
     def __init__(self, pin: int, enabled: bool):
         self._dev = None
         if enabled:
             from gpiozero import OutputDevice  # imported here so --no-gpio works anywhere
-            self._dev = OutputDevice(pin, active_high=True, initial_value=False)
+            # initial_value=True -> HIGH (permissive) immediately, no LOW glitch.
+            self._dev = OutputDevice(pin, active_high=True, initial_value=True)
         self.active = False
 
     def set(self, on: bool) -> None:
         self.active = on
         if self._dev is not None:
-            self._dev.on() if on else self._dev.off()
+            # Inverted for failsafe: trip (on=True) drives LOW, release drives HIGH.
+            if on:
+                self._dev.off()
+            else:
+                self._dev.on()
+
+
+class Heartbeat:
+    """GPIO24 heartbeat: must change level at least every 250ms while alive.
+    Runs on a daemon thread so Modbus blocking/sleep never stalls it.
+    Dummy when --no-gpio is set."""
+
+    def __init__(self, pin: int, enabled: bool, interval: float = HEARTBEAT_INTERVAL_S):
+        self._dev = None
+        self._enabled = enabled
+        self._interval = interval
+        self._stop = threading.Event()
+        self._thread = None
+        if enabled:
+            from gpiozero import OutputDevice  # imported here so --no-gpio works anywhere
+            self._dev = OutputDevice(pin, active_high=True, initial_value=False)
+
+    def _loop(self) -> None:
+        while not self._stop.is_set():
+            try:
+                if self._dev is not None:
+                    self._dev.toggle()
+            except Exception:
+                pass
+            self._stop.wait(self._interval)
+
+    def start(self) -> None:
+        if not self._enabled:
+            return
+        self._thread = threading.Thread(target=self._loop, daemon=True)
+        self._thread.start()
+
+    def stop(self) -> None:
+        self._stop.set()
+        # Leave pin LOW (failsafe) on clean exit; absence of toggling also trips.
+        try:
+            if self._dev is not None:
+                self._dev.off()
+        except Exception:
+            pass
 
 
 def main() -> int:
