 class TripLine:
-    """GPIO23 safety-trip output. Falls back to a dummy when --no-gpio is set."""
+    """Failsafe trip output on GPIO23: HIGH=permissive, LOW=trip.
+
+    Logical API: set(True) = TRIP (drive LOW), set(False) = permissive
+    (drive HIGH). Falls back to a dummy when --no-gpio is set.
+    """
 
     def __init__(self, pin: int, enabled: bool):
         self._dev = None
         if enabled:
             from gpiozero import OutputDevice  # imported here so --no-gpio works anywhere
-            self._dev = OutputDevice(pin, active_high=True, initial_value=False)
+            # Energize-to-run: idle HIGH with no LOW glitch at startup.
+            self._dev = OutputDevice(pin, active_high=True, initial_value=True)
         self.active = False
 
     def set(self, on: bool) -> None:
         self.active = on
         if self._dev is not None:
-            self._dev.on() if on else self._dev.off()
+            # on=True means tripped -> LOW; on=False means permissive -> HIGH
+            self._dev.off() if on else self._dev.on()
+
+
+class Heartbeat:
+    """GPIO24 heartbeat for failsafe interlock: must change level every 250ms.
+
+    Runs a daemon thread so Modbus blocking/sleep never stalls it.
+    """
+
+    def __init__(self, pin: int, enabled: bool, interval: float = HEARTBEAT_INTERVAL_S):
+        self._dev = None
+        self._stop = threading.Event()
+        self._thread = None
+        self._interval = interval
+        if enabled:
+            from gpiozero import OutputDevice
+            self._dev = OutputDevice(pin, active_high=True, initial_value=False)
+            self._thread = threading.Thread(target=self._run, daemon=True)
+            self._thread.start()
+
+    def _run(self) -> None:
+        state = False
+        while not self._stop.is_set():
+            state = not state
+            try:
+                if self._dev is not None:
+                    self._dev.on() if state else self._dev.off()
+            except Exception:
+                break
+            self._stop.wait(self._interval)
+
+    def stop(self) -> None:
+        self._stop.set()
+        try:
+            if self._thread is not None:
+                self._thread.join(timeout=0.5)
+        except Exception:
+            pass
 
 
