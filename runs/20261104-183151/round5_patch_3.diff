 class TripLine:
-    """GPIO23 safety-trip output. Falls back to a dummy when --no-gpio is set."""
+    """Failsafe GPIO23: HIGH=permissive (battery allowed), LOW=trip.
+
+    set(True) means TRIPPED -> drives LOW (interlock open).
+    set(False) means RELEASED/permissive -> drives HIGH.
+    Falls back to a dummy when --no-gpio is set.
+    Init drives HIGH immediately (no LOW glitch) before first poll.
+    """
 
     def __init__(self, pin: int, enabled: bool):
         self._dev = None
         if enabled:
             from gpiozero import OutputDevice  # imported here so --no-gpio works anywhere
-            self._dev = OutputDevice(pin, active_high=True, initial_value=False)
+            # Failsafe idle is energized HIGH.
+            self._dev = OutputDevice(pin, active_high=True, initial_value=True)
         self.active = False
 
     def set(self, on: bool) -> None:
         self.active = on
         if self._dev is not None:
-            self._dev.on() if on else self._dev.off()
+            if on:
+                self._dev.off()  # LOW = trip
+            else:
+                self._dev.on()  # HIGH = permissive
+
+
+class Heartbeat:
+    """GPIO24 heartbeat: must change level at least every 250ms.
+
+    Runs on a daemon thread so Modbus blocking/timeout/sleep never stalls it.
+    Continues while tripped; stopping (kill/freeze) lets bench trip via timeout.
+    Dummy when --no-gpio.
+    """
+
+    def __init__(self, pin: int, enabled: bool, interval: float = HEARTBEAT_INTERVAL_S):
+        self._dev = None
+        self._interval = interval
+        self._stop = threading.Event()
+        self._thread = None
+        if enabled:
+            from gpiozero import OutputDevice
+            self._dev = OutputDevice(pin, active_high=True, initial_value=False)
+
+    def start(self) -> None:
+        if self._dev is None:
+            return
+        self._stop.clear()
+
+        def _loop() -> None:
+            while not self._stop.is_set():
+                try:
+                    self._dev.toggle()
+                except Exception:
+                    pass
+                self._stop.wait(self._interval)
+
+        self._thread = threading.Thread(target=_loop, daemon=True)
+        self._thread.start()
+
+    def stop(self) -> None:
+        self._stop.set()
+        # Daemon thread exits on its own; join briefly if started.
+        t = self._thread
+        if t is not None:
+            try:
+                t.join(timeout=0.2)
+            except Exception:
+                pass
 
 
