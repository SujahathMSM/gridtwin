 class TripLine:
-    """GPIO23 safety-trip output. Falls back to a dummy when --no-gpio is set."""
+    """Failsafe trip output on GPIO23: HIGH=permissive, LOW=trip.
+
+    active=True means tripped (LOW); active=False means permissive (HIGH).
+    Falls back to a dummy when --no-gpio is set.
+    """
 
     def __init__(self, pin: int, enabled: bool):
         self._dev = None
         if enabled:
             from gpiozero import OutputDevice  # imported here so --no-gpio works anywhere
-            self._dev = OutputDevice(pin, active_high=True, initial_value=False)
+            # Boot permissive (HIGH) immediately so healthy idle holds closed.
+            self._dev = OutputDevice(pin, active_high=True, initial_value=True)
         self.active = False
 
     def set(self, on: bool) -> None:
         self.active = on
         if self._dev is not None:
-            self._dev.on() if on else self._dev.off()
+            # Failsafe polarity: trip (on=True) drives LOW, permissive drives HIGH.
+            self._dev.off() if on else self._dev.on()
+
+
+class Heartbeat:
+    """GPIO24 heartbeat: toggles at least every 250ms while alive.
+
+    Runs in a daemon thread independent of the blocking Modbus poll loop so
+    poll_ms 50-500 plus SERIAL_TIMEOUT_S never starves it. Frozen/killed
+    process halts toggling -> interlock opens by itself.
+    """
+
+    def __init__(self, pin: int, enabled: bool, period_s: float = HEARTBEAT_PERIOD_S):
+        self._dev = None
+        self._stop = None
+        self._thread = None
+        self._period = period_s
+        if enabled:
+            from gpiozero import OutputDevice  # imported here so --no-gpio works anywhere
+            self._dev = OutputDevice(pin, active_high=True, initial_value=False)
+            self._stop = threading.Event()
+            self._thread = threading.Thread(target=self._run, daemon=True)
+            self._thread.start()
+
+    def _run(self) -> None:
+        assert self._stop is not None
+        while not self._stop.is_set():
+            try:
+                if self._dev is not None:
+                    self._dev.toggle()
+            except Exception:
+                pass
+            self._stop.wait(self._period)
+
+    def stop(self) -> None:
+        if self._stop is not None:
+            self._stop.set()
+            try:
+                if self._thread is not None and threading.current_thread() is not self._thread:
+                    self._thread.join(timeout=0.5)
+            except Exception:
+                pass
 
 
